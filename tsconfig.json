{
  "extends": "@mendix/pluggable-widgets-tools/configs/tsconfig.base",
  "compilerOptions": {
    "baseUrl": "./",
    "jsx": "react",
    "lib": [
      "dom",
      "esnext"
    ],
    "module": "esnext",
    "esModuleInterop": true,
    "jsxFactory": "React.createElement"
  },
  "exclude": [
    "node_modules"
  ],
  "include": [
    "./src",
    "./typings"
  ]
}
